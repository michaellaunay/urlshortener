# Environment for the systemd unit — copy to
# /srv/urlshortener/etc/urlshortener.env, then `chmod 0640` and
# `chown root:urlshortener`. It may hold a database password.
#
# Read by systemd (EnvironmentFile), NOT by python-dotenv: the unit
# does not depend on the current directory for its configuration.

# ABSOLUTE, and under the unit's ReadWritePaths. Relative forms resolve
# against the .ini file's own directory, which is etc/ — read-only
# under ProtectSystem=strict (audit E-01).
SQLALCHEMY_URL=sqlite:////srv/urlshortener/var/urlshortener.sqlite

# The PUBLIC prefix of the short links, trailing slash included. This
# is the one setting that cannot be corrected afterwards: it is printed
# into every link handed out.
URLSHORTENER_BASE_URL=https://example.org/

# DELIBERATELY ABSENT: URLSHORTENER_LISTEN, URLSHORTENER_TRUSTED_PROXY
# and URLSHORTENER_TRUSTED_PROXY_COUNT (audit N-02). They map onto
# [server:main], and the only code performing that mapping —
# docker/apply_server_overrides.py — runs in the container, never
# here: under systemd, pserve reads that section straight from
# production.ini. A variable in this file that nothing on this path
# reads is a setting the operator believes in and that never arrives
# (the C-07/E-04 shape). On bare metal, edit [server:main] in
# /srv/urlshortener/etc/production.ini instead: listen, trusted_proxy,
# trusted_proxy_count.
#
# Any APPLICATION setting (URLSHORTENER_COUNT_HITS,
# URLSHORTENER_ENABLE_LEGACY_GET, URLSHORTENER_THROTTLE_MAX, ...) may
# be set here: the application reads those itself, wherever it runs.
