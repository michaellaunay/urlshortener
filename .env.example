# Copy to `.env` and adjust. Every value here overrides the matching
# `urlshortener.*` key of the .ini file, so the same image can serve
# several deployments.
#
# `.env` is in .gitignore — never commit the real one.

# PUBLIC prefix of the short links, trailing slash included.
URLSHORTENER_BASE_URL=https://example.org/

# Database. SQLite by default; the file must live on a volume.
SQLALCHEMY_URL=sqlite:////home/urlshortener/app/var/urlshortener.sqlite

# Largest accepted request body, in bytes. Caps waitress AND the
# application's own check, from this one value.
URLSHORTENER_MAX_BODY_BYTES=16384

# Length of a freshly generated code. 11 -> 62^11, about 5.2e19
# possibilities, or 65.5 bits — the length of a YouTube identifier.
# Lower it only if you have measured why; existing shorter codes keep
# resolving either way.
URLSHORTENER_CODE_LENGTH=11

# Serve `GET /?url=...`, the 2016 entry point that creates a link.
# Leave it on while any caller still uses it; grep the log for
# "legacy GET /?url= used" to find out.
URLSHORTENER_ENABLE_LEGACY_GET=true

# Refuse targets pointing at loopback/private/link-local addresses.
URLSHORTENER_BLOCK_PRIVATE_TARGETS=true

# Space- or comma-separated host names always refused.
URLSHORTENER_BLOCKED_HOSTS=

# Creations allowed per client address per window (0 disables).
URLSHORTENER_THROTTLE_MAX=30
URLSHORTENER_THROTTLE_WINDOW=300

# Cross-origin callers for the JSON API. Empty = none. '*' = everyone.
URLSHORTENER_CORS_ORIGINS=

# Waitress binding inside the container. MUST be 0.0.0.0 there: the
# loopback of a container's own namespace is not reachable through a
# published port.
URLSHORTENER_LISTEN=0.0.0.0:5123

# Address the reverse proxy arrives from, so X-Forwarded-For is read
# and `client_addr` is the visitor rather than the proxy. Leave EMPTY
# in a container: the entrypoint substitutes the default gateway, which
# is where nginx on the host comes from. `none` trusts no proxy.
URLSHORTENER_TRUSTED_PROXY=

# Position, counted from the right of X-Forwarded-For, at which the
# visitor's address sits. One reverse proxy = 1. Add a CDN in front and
# this becomes 2 — leave it wrong and the visitor supplies their own
# address.
URLSHORTENER_TRUSTED_PROXY_COUNT=1
